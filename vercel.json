{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/enquiry.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/demos/:slug",
      "destination": "/api/demo-gate?slug=:slug"
    },
    {
      "source": "/demos/:slug/:path*",
      "destination": "/api/demo-gate?slug=:slug&path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://formsubmit.co; font-src 'self'; frame-src https://cal.com https://app.cal.com; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!receptionist-demo).*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    },
    {
      "source": "/receptionist-demo(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/jobfilter",
      "destination": "https://jobfilter.uk/find-jobs",
      "permanent": true
    },
    {
      "source": "/work/scrap-finance-partners",
      "destination": "https://scrap-finance-partners.vercel.app",
      "permanent": true
    },
    {
      "source": "/free-templates",
      "destination": "/free-membership",
      "permanent": true
    },
    {
      "source": "/free-toolkit",
      "destination": "/free-membership",
      "permanent": true
    },
    {
      "source": "/start",
      "has": [
        {
          "type": "query",
          "key": "package",
          "value": "(?<pkg>.*)"
        }
      ],
      "destination": "/contact?intent=setup&package=:pkg",
      "permanent": true
    },
    {
      "source": "/free-plan",
      "has": [
        {
          "type": "query",
          "key": "src",
          "value": "(?<src>.*)"
        }
      ],
      "destination": "/contact?intent=preview&src=:src",
      "permanent": true
    },
    {
      "source": "/free-plan",
      "has": [
        {
          "type": "query",
          "key": "trade",
          "value": "(?<trade>.*)"
        }
      ],
      "destination": "/contact?intent=preview&trade=:trade",
      "permanent": true
    },
    {
      "source": "/leak-check",
      "destination": "/contact?intent=preview",
      "permanent": true
    },
    {
      "source": "/quick-win",
      "destination": "/prices",
      "permanent": true
